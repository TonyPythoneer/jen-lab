{
  // scripts/ — extends root tsconfig; switches to NodeNext resolution for node: imports.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "shared/**/*.ts"]
}
