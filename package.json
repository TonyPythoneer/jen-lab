{
  "name": "jen-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm gen:icons && velite build --strict && vite-ssg build && vue-tsc --noEmit",
    "dev": "pnpm gen:icons && (velite --watch & vp dev)",
    "gen:icons": "jiti scripts/build-icon-subset.ts",
    "bundle:report": "pnpm build && jiti scripts/github/bundle-report.ts",
    "inspect": "SONDA=true pnpm build",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006}",
    "build-storybook": "storybook build",
    "check": "vp check && pnpm typecheck",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test run",
    "preview": "pnpm build && pnpm dlx serve dist",
    "deploy": "pnpm build && wrangler pages deploy",
    "cf-typegen": "wrangler types",
    "sync:wp": "jiti scripts/sync-wp.ts",
    "sync:ferries:osm": "jiti scripts/sync-ferries-osm.ts",
    "ai:screenshot": "jiti scripts/screenshot.ts",
    "prepare": "vp config",
    "kg:vue": "jiti scripts/kg-vue/index.ts",
    "bench:build": "time vite-ssg build",
    "bench:vize": "VIZE=true pnpm bench:build",
    "verify:ssg": "jiti scripts/ci/assert-ssg-output.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@types/leaflet": "^1.9.21",
    "@unhead/vue": "^3.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "ofetch": "^1.5.1",
    "reka-ui": "^2.9.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/simple-icons": "^1.2.85",
    "@playwright/test": "^1.60.0",
    "@storybook/vue3-vite": "^10.4.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vizejs/vite-plugin": "0.203.0",
    "@vueuse/core": "^14.3.0",
    "jiti": "2.7.0",
    "markdown-it": "^14.1.1",
    "markdown-it-link-attributes": "^4.0.1",
    "playwright": "^1.60.0",
    "rolldown": "catalog:",
    "sonda": "^0.12.1",
    "storybook": "^10.4.1",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "velite": "^0.3.1",
    "vite": "catalog:",
    "vite-plugin-inspect": "11.4.1",
    "vite-plugin-vue-layouts-next": "^2.1.0",
    "vite-plus": "catalog:",
    "vite-ssg": "^28.3.0",
    "vitest": "catalog:",
    "vue-component-meta": "^3.3.3",
    "vue-tsc": "^3.3.3",
    "wrangler": "^4.86.0",
    "yaml": "^2.8.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.5.2"
}
