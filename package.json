{
  "name": "jen-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "velite build && vite-ssg build",
    "dev": "velite build && vp dev --host 0.0.0.0 --port ${DEV_PORT:-3500}",
    "dev:watch": "velite --watch & vp dev --host 0.0.0.0 --port ${DEV_PORT:-3500}",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006}",
    "build-storybook": "storybook build",
    "typecheck": "vp check",
    "check": "vp check",
    "test": "vp test run",
    "test:watch": "vp test",
    "generate": "velite build && vite-ssg build",
    "preview": "npm run build && npx serve dist",
    "ssg:build": "velite build && vite-ssg build",
    "ssg:preview": "npm run ssg:build && npx serve dist",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types",
    "sync:wp": "node --experimental-strip-types scripts/sync-wp.ts",
    "sync:ferries:osm": "node --experimental-strip-types scripts/sync-ferries-osm.ts",
    "ai:screenshot": "node --experimental-strip-types scripts/screenshot.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@types/leaflet": "^1.9.21",
    "@unhead/vue": "^3.1.3",
    "@vueuse/router": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "leaflet": "^1.9.4",
    "ofetch": "^1.5.1",
    "reka-ui": "^2.9.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-router": "^5.1.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/simple-icons": "^1.2.85",
    "@nuxt/ui": "^4.7.1",
    "@playwright/test": "^1.60.0",
    "@storybook/vue3-vite": "^10.4.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/core": "^14.3.0",
    "fflate": "^0.8.2",
    "markdown-it": "^14.1.1",
    "markdown-it-link-attributes": "^4.0.1",
    "playwright": "^1.60.0",
    "rolldown": "catalog:",
    "storybook": "^10.4.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.19.2",
    "velite": "^0.3.1",
    "vite": "catalog:",
    "vite-plugin-vue-layouts-next": "^2.1.0",
    "vite-plus": "catalog:",
    "vite-ssg": "^28.3.0",
    "vitest": "catalog:",
    "wrangler": "^4.86.0",
    "yaml": "^2.8.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.0.3"
}
